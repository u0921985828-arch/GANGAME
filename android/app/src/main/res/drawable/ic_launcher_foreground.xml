<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground: a 2x2 sampler pad grid (the app's signature control), centered in the
     72dp safe zone of the 108dp canvas. Three pads in dim accent, the top-right one lit bright with a
     LED dot — reads instantly as a groovebox/sampler. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- three dim pads: top-left, bottom-left, bottom-right -->
    <path
        android:fillColor="#C9772C"
        android:pathData="M30,24 h15 a6,6 0 0 1 6,6 v15 a6,6 0 0 1 -6,6 h-15 a6,6 0 0 1 -6,-6 v-15 a6,6 0 0 1 6,-6 z
                          M30,57 h15 a6,6 0 0 1 6,6 v15 a6,6 0 0 1 -6,6 h-15 a6,6 0 0 1 -6,-6 v-15 a6,6 0 0 1 6,-6 z
                          M63,57 h15 a6,6 0 0 1 6,6 v15 a6,6 0 0 1 -6,6 h-15 a6,6 0 0 1 -6,-6 v-15 a6,6 0 0 1 6,-6 z" />

    <!-- lit pad: top-right, bright accent -->
    <path
        android:fillColor="#FF9A3D"
        android:pathData="M63,24 h15 a6,6 0 0 1 6,6 v15 a6,6 0 0 1 -6,6 h-15 a6,6 0 0 1 -6,-6 v-15 a6,6 0 0 1 6,-6 z" />

    <!-- LED dot on the lit pad -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M79,29 m-2.4,0 a2.4,2.4 0 1 0 4.8,0 a2.4,2.4 0 1 0 -4.8,0 z" />
</vector>
