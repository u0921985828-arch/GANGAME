<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      INTERNET is REQUIRED even though the app is fully offline: WebViewAssetLoader serves the app
      from a virtual https origin (https://appassets.androidhost/…), and the WebView routes that
      https load through its network stack — without the INTERNET permission it aborts the main-frame
      load with net::ERR_CACHE_MISS before the asset handler can respond. The app still makes NO real
      network requests (CSP: connect-src 'self'; no fetch/XHR/WebSocket), so "no data transmitted"
      remains true for the Data Safety form. No dangerous permissions:
        · Content served from assets/ via WebViewAssetLoader (secure https origin).
        · Audio import uses the WebView file chooser → Storage Access Framework (no permission).
        · Audio export/save uses ACTION_CREATE_DOCUMENT (SAF) → the user picks the location,
          no storage permission on any API level.
        · "REC / RESAMPLE" records the internal audio bus (recDest), NOT the microphone → no RECORD_AUDIO.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.App.Starting">

        <!--
          Safe Browsing OFF: la app es 100% offline (contenido servido desde assets/ por
          WebViewAssetLoader, CSP connect-src 'self', sin fetch/XHR/WebSocket). Safe Browsing
          inicializa un componente de GMS y hace comprobaciones de URL que aquí no protegen de
          nada → se desactiva para no pagar ese coste en el arranque. Pre-init vía meta-data
          (cubre todas las API); además se refuerza en runtime en configureWebView (API 26+).
        -->
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density"
            android:theme="@style/Theme.App.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
